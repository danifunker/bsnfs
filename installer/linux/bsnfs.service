# The packaged service. It runs as the `bsnfs` system user, so that account's
# permissions decide what clients can read and write: give it access to the
# folders you share (e.g. `sudo chgrp -R bsnfs /srv/irix && sudo chmod -R g+rwX /srv/irix`).
#
# To run as your own account instead: sudo bsnfs service install --user you
# (that writes /etc/systemd/system/bsnfs.service, which takes precedence).

[Unit]
Description=bsnfs NFS server
After=network-online.target
Wants=network-online.target

[Service]
User=bsnfs
Group=bsnfs
ExecStart=/usr/bin/bsnfs --config /etc/bsnfs/bsnfs.conf
StateDirectory=bsnfs
# Lets the service user listen on the portmapper's port 111.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
